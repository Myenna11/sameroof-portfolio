[Unit]
Description=同屋 房间适配器 %i
After=sameroof-living-room.service sameroof-broker.service
Requires=sameroof-living-room.service
[Service]
Type=simple
WorkingDirectory=/root/sameroof/packages/adapters/broker-direct
ExecStart=/usr/bin/node adapter.js %i
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=HOME=/root
NoNewPrivileges=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
