{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sameroof.local/schema/house-v1.json",
  "title": "Same Roof house.yaml v1",
  "type": "object",
  "required": ["schema_version", "name", "timezone", "defaults", "credentials", "notify"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quiet_hours": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]-(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["runtime", "plugins", "heartbeat", "context", "approve_timeout", "permissions"],
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "plugins": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "heartbeat": { "$ref": "https://sameroof.local/schema/room-v1.json#/$defs/heartbeat" },
        "context": {
          "$ref": "https://sameroof.local/schema/room-v1.json#/$defs/context",
          "required": ["recent_messages", "recent_max_chars", "memory_hits", "memory_recent"]
        },
        "deliver": { "$ref": "https://sameroof.local/schema/room-v1.json#/$defs/deliver" },
        "limits": { "$ref": "https://sameroof.local/schema/room-v1.json#/$defs/limits" },
        "approve_timeout": { "type": "string", "pattern": "^[1-9][0-9]*(?:s|m|h|d)$" },
        "permissions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$" },
          "additionalProperties": { "enum": ["allow", "approve", "deny"] }
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alias", "provider", "purpose"],
        "additionalProperties": false,
        "properties": {
          "alias": { "type": "string", "minLength": 1, "maxLength": 120 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
          "mode": { "enum": ["broker", "runtime_managed"], "default": "broker" },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "notify": {
      "type": "object",
      "required": ["admin"],
      "additionalProperties": false,
      "properties": { "admin": { "type": "string", "minLength": 1, "maxLength": 80 } }
    },
    "routines": { "$ref": "https://sameroof.local/schema/room-v1.json#/$defs/routines" },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$" },
      "additionalProperties": {}
    }
  }
}
