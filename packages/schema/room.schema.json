{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sameroof.local/schema/room-v1.json",
  "title": "Same Roof room.yaml v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^resident_[a-z0-9][a-z0-9_-]*$",
      "minLength": 12,
      "maxLength": 96
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "default": []
    },
    "species": {
      "enum": [
        "agent",
        "human"
      ],
      "default": "agent"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
      },
      "additionalProperties": {
        "enum": [
          "allow",
          "approve",
          "deny"
        ]
      }
    },
    "approve_timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:s|m|h|d)$"
    },
    "heartbeat": {
      "$ref": "#/$defs/heartbeat"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "deliver": {
      "$ref": "#/$defs/deliver"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "routines": {
      "$ref": "#/$defs/routines"
    },
    "avatar": {
      "$ref": "#/$defs/avatar"
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "notify": {
      "type": "object",
      "required": [
        "channel"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quiet_hours": {
          "$ref": "#/$defs/quietHours"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$"
      },
      "additionalProperties": {}
    },
    "subagent": {
      "type": "object",
      "additionalProperties": false,
      "description": "subagent V0 (docs/design/subagents.md): in-process subruns for broker-direct residents",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240
            }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "core.fs.read",
              "core.exec.ro"
            ]
          }
        },
        "inherit_max_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "summary_max_words": {
          "type": "integer",
          "minimum": 20,
          "maximum": 5000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "species"
        ],
        "properties": {
          "species": {
            "const": "human"
          }
        }
      },
      "then": {
        "properties": {
          "model": false,
          "heartbeat": false,
          "plugins": false,
          "routines": false
        }
      },
      "else": {
        "required": [
          "model"
        ]
      }
    }
  ],
  "$defs": {
    "deliverMode": {
      "enum": [
        "interrupt",
        "after_turn",
        "inject"
      ]
    },
    "deliver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "human": {
          "$ref": "#/$defs/deliverMode"
        },
        "agent": {
          "$ref": "#/$defs/deliverMode"
        },
        "from": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 96
          },
          "additionalProperties": {
            "$ref": "#/$defs/deliverMode"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "agent_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "routine": {
      "type": "object",
      "required": [
        "id",
        "cron",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "cron": {
          "type": "string",
          "minLength": 9,
          "maxLength": 160
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "quiet_hours": {
          "enum": [
            "ignore",
            "respect"
          ],
          "default": "ignore"
        }
      }
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routine"
      },
      "maxItems": 64
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recent_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "recent_max_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "memory_hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "memory_recent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "emoji"
          ]
        },
        {
          "required": [
            "image"
          ]
        }
      ],
      "properties": {
        "emoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$"
        }
      }
    },
    "quietHours": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]-(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "auth": {
      "type": "object",
      "required": [
        "mode",
        "credential"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "broker",
            "runtime_managed"
          ]
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "modelRef": {
      "type": "object",
      "required": [
        "provider",
        "id",
        "auth"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "provider",
        "id",
        "auth"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "fallback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelRef"
          },
          "maxItems": 8
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "minimal",
            "standard",
            "autonomous"
          ]
        },
        "interval": {
          "oneOf": [
            {
              "const": "adaptive"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*(?:s|m|h)$"
            }
          ]
        },
        "quiet_hours": {
          "$ref": "#/$defs/quietHours"
        },
        "budget": {
          "type": "object",
          "required": [
            "per_day",
            "on_exceeded"
          ],
          "additionalProperties": false,
          "properties": {
            "per_day": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "type": "integer",
                  "minimum": 0
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "usd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "on_exceeded": {
              "enum": [
                "passive",
                "deny"
              ]
            }
          }
        },
        "on_wake": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "concerns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "on_sleep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
